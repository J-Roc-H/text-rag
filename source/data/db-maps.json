  "프론테라": {"level": "0", "type": "마을", "emoji": "🏰", "desc": "룬 미드가츠의 심장.", "entryDesc": "성문을 지나자 낯익은 석조 거리가 펼쳐진다. 광장 주변으로 상인들의 외침과 기사들의 발소리가 뒤섞인다.", "firstVisitDesc": "왕국의 심장부에 처음 발을 들였다. 여기서부터 모든 것이 시작된다.", "connected": ["프론테라 왕궁", "프론테라 성당", "프론테라 북쪽 평원", "프론테라 남쪽 평원", "프론테라 서쪽 평원", "프론테라 동쪽 평원", "프론테라 지하수로 1층"], "dirs": {"north": "프론테라 북쪽 평원", "south": "프론테라 남쪽 평원", "east": "프론테라 동쪽 평원", "west": "프론테라 서쪽 평원"}, "monsters": [], "safe": true},
  "프론테라 왕궁": {"level": "0", "type": "마을", "emoji": "👑", "desc": "프론테라의 서쪽 왕궁. 기사단의 본부.", "entryDesc": "광장의 소음이 멀어지고 정돈된 석조 공간이 이어진다. 갑옷을 갖춘 기사들이 오가고, 말소리보다 발굽과 군화 소리가 더 자주 들린다.", "firstVisitDesc": "프론테라의 거리와는 분위기가 확연히 다르다. 이곳에서는 모험가보다 왕국 기사단의 질서가 먼저 눈에 들어온다.", "connected": ["프론테라"], "dirs": {"east": "프론테라"}, "monsters": [], "safe": true},
  "프론테라 성당": {"level": "0", "type": "마을", "emoji": "⛪", "desc": "프론테라의 동쪽 성당. 신앙의 중심.", "entryDesc": "두꺼운 문 안쪽으로 들어서자 바깥의 소음이 한결 낮아진다. 높은 천장 아래로 사람들의 작은 발소리와 낮은 목소리가 울린다.", "firstVisitDesc": "한쪽에서는 기도를 올리고, 다른 쪽에서는 수행자들이 사람을 맞는다. 이곳의 신앙은 예배만이 아니라 여러 직업의 수련과도 이어져 있는 모양이다.", "connected": ["프론테라"], "dirs": {"west": "프론테라"}, "monsters": [], "safe": true},
  "프론테라 남쪽 평원": {"level": "1~5", "type": "필드", "emoji": "🌿", "desc": "초보 모험가들의 수련장.", "entryDesc": "성문을 벗어나자 낮은 풀밭이 트인다. 포링과 루나틱이 여기저기서 얼쩡거린다.", "firstVisitDesc": "처음 나선 사냥터다. 위험할 건 없어 보이지만, 아직 긴장을 놓기엔 이르다.", "connected": ["프론테라", "이즈루드", "소그라트 사막 동부"], "dirs": {"north": "프론테라", "south": "이즈루드", "west": "소그라트 사막 동부"}, "monsters": [1, 2, 3, 4, 5, 6], "safe": false},
  "프론테라 서쪽 평원": {"level": "4~12", "type": "필드", "emoji": "🌾", "desc": "게펜으로 향하는 들판.", "entryDesc": "길 양옆으로 풀밭과 낮은 나무들이 이어진다. 윌로우 사이로 픽키가 돌아다니고, 풀숲에서는 로커 소리가 끊이지 않는다.", "firstVisitDesc": "서쪽으로 난 길은 그대로 게펜 방면으로 이어진다. 왕도 주변을 벗어나 다른 도시로 향하기 시작하는 길이다.", "connected": ["프론테라", "게펜 필드"], "dirs": {"east": "프론테라", "west": "게펜 필드"}, "monsters": [10, 12, 14], "safe": false},
  "프론테라 동쪽 평원": {"level": "9~18", "type": "필드", "emoji": "🌲", "desc": "페이욘으로 향하는 숲.", "entryDesc": "평원이라는 이름과 달리 나무가 눈에 띄게 많아진다. 풀 사이에는 만드라고라가 자리 잡고 있고, 나무 사이로 스모키가 모습을 감췄다 드러낸다.", "firstVisitDesc": "동쪽으로 갈수록 왕도 주변의 탁 트인 들판이 점차 숲길로 바뀐다. 이 길 끝은 페이욘의 숲으로 이어진다.", "connected": ["프론테라", "페이욘 숲 북부"], "dirs": {"west": "프론테라", "south": "페이욘 숲 북부"}, "monsters": [14, 15, 13], "safe": false},
